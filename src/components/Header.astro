---
import logo from '../assets/logos/IMAGOTIPO_HORIZONTAL_FULL_S.png';
const color = "var(--kyngtravels-primary)";
---

<header class="site-header">
  <div class="inner">
    <a class="logo" href="/">
        <img src={logo.src} alt="KyngTravels" class="logo-img" />
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-label="Abrir menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" stroke={color} stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <nav class="nav">
      <a href="/login">Iniciar sesión</a>
      <!-- <a href="#experiencias">Experiencias</a>
      <a href="#contacto">Contacto</a> -->
      <a class="nav-cta" href="https://wa.me/message/MXNH2P2DXIQDA1">Solicitar asesoría</a>
    </nav>
  </div>
</header>

<style>
  .site-header { position:fixed;width:100vw;top:0;z-index:40;background:rgba(255,255,255,0.2);backdrop-filter:blur(6px);border-bottom:1px solid rgba(14,20,37,0.06); }
  .inner { max-width:1100px;margin:0 auto;padding:0.75rem 1rem;display:flex;justify-content:space-between;align-items:center;gap:0.5rem; }
  .logo img { height:66px; }
  .nav { display:flex; gap:0.5rem; align-items:center; }
  .nav a { margin-left:0.75rem;color:var(--text-white);text-decoration:none;padding:0.45rem 0.6rem;border-radius:6px; transition:all 0.18s ease; }
  .nav a:hover{background:rgba(15,23,42,0.04);color:var(--text-hover);transform:translateY(-1px)}
  .nav-cta{background:linear-gradient(90deg,var(--kyngtravels-bg),var(--kyngtravels-surface));color:#383838 !important;font-weight: bold;padding:0.5rem 0.9rem;border-radius:8px;border:none}
  .nav-cta:hover{color:var(--text-hover) !important;transform:translateY(-1px)}
  .nav-toggle{display:none;background:transparent;border:0;border: 1px solid var(--kyngtravels-primary);border-radius: 0.5em;padding:0.5rem;margin-left:0.5rem}

  /* When the asesoria section is active, change nav colors */
  .site-header.in-asesoria { background: rgba(190, 195, 197, 0.71); transition: background 0.3s ease; }
.site-header.in-asesoria a { color: black; }

  @media (max-width:880px){
    .logo img{height:48px}
    .nav-toggle{display:inline-flex}
    .nav{display:none; position:absolute;left:0;right:0;top:64px;flex-direction:column;background:rgba(86, 86, 86, 0.98);margin:0 1rem;padding:0.75rem;border-radius:10px;box-shadow:0 8px 20px rgba(2,6,23,0.08);max-height:0;overflow:hidden;transition:max-height 0.28s ease}
    .nav.open{display:flex; max-height:420px}
    .nav a{width:100%;padding:0.75rem 1rem;margin:0;color:var(--text-white);border-radius:6px}
    .inner{position:relative}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const siteHeader = document.querySelector('.site-header');
    const btn = document.querySelector('.nav-toggle');
    const nav = document.querySelector('.nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', () => {
      const open = nav.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    });

    // Close the nav when any link inside it is clicked (useful on mobile)
    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        if (nav.classList.contains('open')) {
          nav.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Abrir menú');
        }
      });
    });

    
    // Close the nav if the user clicks outside the nav or the toggle button
    document.addEventListener('click', (e: Event) => {
      if (!nav.classList.contains('open')) return;
      // Prefer composedPath for shadow DOM correctness; fallback to e.path
      const path: any[] = (typeof (e as any).composedPath === 'function')
        ? (e as any).composedPath()
        : (e as any).path || [];
      if (path && path.length) {
        if (path.indexOf(nav) !== -1 || path.indexOf(btn) !== -1) return;
      } else {
        const target = e.target;
        if (target instanceof Node) {
          if (nav.contains(target) || btn.contains(target)) return;
        }
      }
      nav.classList.remove('open');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menú');
    });


    const about = document.querySelector("#asesoria");
    window.addEventListener("scroll", () => {
    const scrollPosition = window.scrollY;

      if (!about) return;
      if (!siteHeader) return;
      const aboutPosition = about.getBoundingClientRect().top + window.scrollY;

      if (scrollPosition >= aboutPosition) {
        console.log("En Asesoría");
        siteHeader.classList.add("in-asesoria");
      } else {
        siteHeader.classList.remove("in-asesoria");
        console.log("Todavía estoy en Hero");
      }
    });
  });
</script>
