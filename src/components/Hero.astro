---
import imgViaje from '../assets/PlanificaMundo.jpg';
import Icon from "./Icon";
import { faCircleCheck } from "@fortawesome/free-solid-svg-icons";
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-inner">
      <h1>
        Asesoría de viajes  
        <span> a tu medida </span>
      </h1>
      <p class="subtitle">
        No vendemos paquetes genéricos. <span>Diseñamos experiencias únicas</span> adaptadas a tus sueños, presupuesto y preferencias.
      </p>
      <div class="hero-features">
        <div class="hero-feature">
          <div><Icon icon={faCircleCheck} className="puntos"/></div>
          <div><p>Especialistas en Colombia y destinos internacionales</p></div>
        </div>
        <div class="hero-feature">
          <div><Icon icon={faCircleCheck} className="puntos" /></div>
          <div><p>Planificación completa: vuelos, hoteles, tours y más</p></div>
        </div>
        <div class="hero-feature">
          <div><Icon icon={faCircleCheck} className="puntos" /></div>
          <div><p>Acompañamiento antes, durante y después del viaje</p></div>
        </div>
      </div>
      <div class="hero-actions">
        <a href="mailto:contacto@kyngtravels.com" class="btn btn-kyngtravels">Contáctanos</a>
      </div>
    </div>
    <div class="hero-img">
      <img src={imgViaje.src} alt="Planifica tu mundo">
    </div>
  </div>
</section>

<style>
  .hero {
    height: 100vh;
    box-sizing: border-box;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 6rem 1rem 2rem 1rem;

    background: linear-gradient(180deg, #0f172a 0%, #07103a 100%);
    color: #fff;
    text-align: center;
  }
  
  .hero-container {
    width: 100%;
    max-width: 960px;

    height: 100%;

    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;

    color: #fff;
  }

  .hero-inner {
    width: 100%;
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-inner h1 {
    text-align: start;
    color: #fff;
    font-size: 2.5rem;
    margin: 0 0 0.5rem 0;
  }

  .hero-inner h1 span {
    display: block;
  }

  .hero-img { 
    width: 100%;
    height: 100%; 

    display:flex; 
    align-items:center; 
    justify-content:center; 
  }

  .hero-img img {
    height: 70%;
    max-width: 500px;
    border-radius: 24px;
    box-shadow: 0 18px 50px rgba(2,6,23,0.55);
  }

  .hero-features {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    gap: 0.5rem;
    margin: 1.5rem 0;
  }
  .hero-feature  {
    display: flex;
    flex-direction: row;
    justify-content: start;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-feature p {
    margin: 0.75em 0;
  }
  .subtitle {
    text-align: start;
    color: rgba(255,255,255,0.85);
    margin: 0;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .search-slot {
    margin-top: 1rem;
  }


  @media (max-height: 720px) {
    h1 { font-size: 1.5rem; }
    .hero { padding: 5rem 1rem; }
    .hero-actions{ flex-direction:column; justify-content:center; align-items:center; }
    .hero-actions .btn{ width:80% }
    .hero-features { gap: 0; }
    .hero-feature p { margin: 0.25em 0; }
  }
  @media (max-width: 768px) {
    .hero-container {
      flex-direction: column-reverse;
      text-align: center;
    }
    .hero-img {
      overflow: hidden;
    }
    .hero-img img {
      width: 100%;
      height: 80%;
      object-fit: cover;
      object-position: center;
      border-radius: 20px;
    }
  }
</style>
