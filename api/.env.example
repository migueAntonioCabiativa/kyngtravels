# =========================================
# KyngTravels API - Variables de entorno
# =========================================
# Copia este archivo como .env y completa los valores reales.
# No se debe subir .env a GitHub.

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kyngtravels_db
DB_USER=kyngtravels_user
DB_PASS=change_me_strong_password
DB_CHARSET=utf8mb4

# JWT / autenticación
JWT_SECRET=replace_with_a_secure_random_string
JWT_ALGORITHM=HS256
JWT_TTL=3600

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# Correo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@kyngtravels.com

# WhatsApp / integraciones
WHATSAPP_PHONE=573001234567
WHATSAPP_MESSAGE_URL=https://wa.me/message/MXNH2P2DXIQDA1
